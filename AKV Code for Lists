##############################
###### with Keyvault name ######
################################

$keyVaultName = "testrgkvq1"

Connect-AzAccount -Identity

$allSecrets = Get-AzKeyVaultSecret -VaultName $keyVaultName

foreach ($secret in $allSecrets) {
    $secretObj = Get-AzKeyVaultSecret -VaultName $keyVaultName -Name $secret.Name
    $secretValue   = $secretObj.SecretValueText
    $expiryDate    = $secretObj.Attributes.Expires
    $secretVersion = $secretObj.Id.Split('/')[-1]

    Write-Host "Secret Name   : $($secretObj.Name)"
    Write-Host "Secret Value  : $secretValue"
    Write-Host "Expiry Date   : $expiryDate"
    Write-Host "Secret Version: $secretVersion"
    Write-Host "Name-Value Pair: $($secretObj.Name) = $secretValue"
    Write-Host "-------------------------------"
}

